
{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "the-zar-website",
  "main": "src/index.js",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "the-zar-db",
      "database_id": "f2e28521-8c6d-4b72-8141-916f4c5a99ff"
    }
  {
  // ...
  "vars": {},
  // ...
}
